{
  "name": "exametra-desktop",
  "version": "1.0.0",
  "private": true,
  "main": "main.js",
  "author": "Exametra",
  "description": "Exametra Secure Lockdown Browser",
  "scripts": {
    "dev": "concurrently \"next dev\" \"npm run lockdown\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lockdown": "electron main.js",
    "build-installer": "node scripts/build-setup.js",
    "package-exe": "electron-builder --win"
  },
  "build": {
    "appId": "com.exametra.app",
    "productName": "Exametra",
    "asar": false,
    "win": {
      "target": "nsis"
    },
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "main.js",
      "package.json"
    ]
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@hookform/resolvers": "^5.5.7",
    "@monaco-editor/react": "^4.7.0",
    "@supabase/supabase-js": "^2.112.4",
    "@tailwindcss/typography": "^0.5.20",
    "@tsparticles/engine": "^4.3.2",
    "@tsparticles/react": "^4.3.2",
    "date-fns": "^4.4.0",
    "gsap": "^3.15.0",
    "lottie-react": "^3.1.0",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.83.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "tsparticles": "^4.3.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
